{
  "name": "modular-cms",
  "version": "2.0.0",
  "description": "Modulares CMS mit Seiten, Blog, Medien, Menüs und Newsletter – Node.js, SQLite, ohne Build-Schritt",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "express": "^5.2.1",
    "nodemailer": "^10.0.13",
    "sanitize-html": "^2.18.0"
  }
}
