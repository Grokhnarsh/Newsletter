# Öffentliche Basis-URL (wird für Links in E-Mails verwendet)
BASE_URL=http://localhost:3000
PORT=3000
HOST=0.0.0.0

# Pfad zur SQLite-Datenbank
DATABASE_PATH=./data/newsletter.db
# Ablage für hochgeladene Medien (öffentlich unter /uploads/)
UPLOADS_DIR=./data/uploads
# Ordner für eigene Module (je Unterordner eine index.js)
MODULES_DIR=./modules
# Theme (Ordner in themes/ oder src/themes/)
THEME=default

# Hinter einem Reverse Proxy (nginx, Traefik, Caddy) auf true setzen
TRUST_PROXY=false

# E-Mail-Versand: smtp | file | log
# Ohne SMTP-Angaben werden Mails als .eml-Dateien in MAIL_OUTBOX_DIR gespeichert.
MAIL_TRANSPORT=
SMTP_URL=
# alternativ einzeln:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_OUTBOX_DIR=./data/outbox

# Versand-Worker
WORKER_ENABLED=true
WORKER_INTERVAL_MS=5000
MAIL_MAX_ATTEMPTS=3

# Sitzungsdauer in Stunden
SESSION_TTL_HOURS=168

# Optional: erstes Administratorkonto automatisch anlegen
# (sonst erfolgt die Einrichtung im Browser unter /admin/)
ADMIN_EMAIL=
ADMIN_PASSWORD=
